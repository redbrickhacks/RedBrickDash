# opt out of nextjs telemetry
NEXT_TELEMETRY_DISABLED=1

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================
# For local dev: Run `supabase start` and use the output values
# For production: Use your Supabase project credentials
NEXT_PUBLIC_HIBISCUS_SUPABASE_API_URL=https://your-project.supabase.co
NEXT_PUBLIC_HIBISCUS_SUPABASE_ANON_KEY=your-anon-key
HIBISCUS_SUPABASE_SERVICE_KEY=your-service-role-key

# ===========================================
# AWS CONFIGURATION (Optional - for team invite emails)
# Without these, team invite emails will fail silently.
# Other features work fine without AWS.
# ===========================================
# HIBISCUS_AWS_ACCESS_KEY_ID=your_aws_access_key
# HIBISCUS_AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# HIBISCUS_AWS_REGION=us-west-1

HIBISCUS_RESEND_API_KEY=your_resend_api_key

# ===========================================
# APPLICATION URLS (Required)
# ===========================================
# For local dev: use http://localhost:4200 (SSO) and http://localhost:4201 (portal)
NEXT_PUBLIC_SSO_URL=https://sso.yourdomain.com
NEXT_PUBLIC_PORTAL_URL=https://portal.yourdomain.com
NEXT_PUBLIC_SSO_DEFAULT_REDIRECT_URL=https://portal.yourdomain.com
NEXT_PUBLIC_HIBISCUS_DOMAIN=yourdomain.com

# ===========================================
# COOKIE CONFIGURATION (Required)
# ===========================================
NEXT_PUBLIC_HIBISCUS_ACCESS_COOKIE_NAME=rbh_access
NEXT_PUBLIC_HIBISCUS_REFRESH_COOKIE_NAME=rbh_refresh
NEXT_PUBLIC_HIBISCUS_COOKIE_MAX_AGE=604800

# ===========================================
# SENTRY ERROR TRACKING (Required for Dashboard build)
# ===========================================
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ===========================================
# FEATURE FLAGS (Required)
# ===========================================
APPS_OPEN=true
WAITLIST_OPEN=false
HACKER_PORTAL_OPEN=true

# ===========================================
# TEAM SETTINGS (Required)
# ===========================================
NEXT_PUBLIC_MAX_TEAM_MEMBERS=4

# ===========================================
# PODIUM / JUDGING (Required for judging feature)
# ===========================================
NEXT_PUBLIC_HIBISCUS_PODIUM_API_URL=https://api.yourdomain.com/podium
HIBISCUS_PODIUM_API_MASTER_TOKEN=your-podium-master-token

# ===========================================
# EVENTS SERVICE (Required for event calendar & check-ins)
# ===========================================
NEXT_PUBLIC_HIBISCUS_EVENTS_API_URL=https://api.yourdomain.com/events
EVENT_MASTER_TOKEN=your-events-master-token
EVENT_AUTH_SERVICE_URL=https://api.yourdomain.com/auth

# ===========================================
# TALLY.SO INTEGRATION (Required if using Tally for applications)
# ===========================================
NEXT_PUBLIC_TALLY_APPS_2024=https://tally.so/r/your-form-id?transparentBackground=1&formEventsForwarding=1
TALLY_API_MASTER_TOKEN=your-tally-api-token
TALLY_SIGNING_SECRET=your-tally-signing-secret

# ===========================================
# SUBMISSION SETTINGS (Required for project submissions)
# ===========================================
NEXT_PUBLIC_TALLY_SUBMISSION_FORM_URL=https://tally.so/r/your-submission-form-id
NEXT_PUBLIC_SUBMISSION_DEADLINE=2025-01-10T23:59:59Z

# Tally Backup in MongoDB
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/?appName=your-app

# Archived Tally forms
# NEXT_PUBLIC_TALLY_APPS_2023_X=https://tally.so/embed/your-form-id

# Legacy - check if still used
# HIBISCUS_HACKER_APP_RESPONSES_TABLENAME=

# ===========================================
# FEATURE FLAGS - OPTIONAL BACKENDS
# ===========================================
# HIBISCUS_FEATURE_FLAG_REDIS_URL=redis://user:pass@localhost:6379
# HIBISCUS_FEATURE_FLAG_MONGO_URI=mongodb://localhost:27017/hibiscus

# ===========================================
# BATTLEPASS (Optional - for gamification features)
# ===========================================
# NEXT_PUBLIC_HIBISCUS_BATTLEPASS_API_URL=https://api.yourdomain.com/battlepass

# ===========================================
# EXTERNAL LINKS (Optional - features degrade gracefully)
# ===========================================
NEXT_PUBLIC_WAIVER_URL=https://example.com/waiver.pdf
NEXT_PUBLIC_HACKER_PACKET_URL=https://example.com/hacker-packet.pdf

# Discord verification API
NEXT_PUBLIC_DISCORD_API_URL=https://api.yourdomain.com/discord
NEXT_PUBLIC_DISCORD_INVITE_URL=your-discord-invite-code

# ===========================================
# LOCAL DEVELOPMENT - SSO BYPASS
# ===========================================
# Uncomment these for local development without real SSO

# Mock SSO app URL (not needed if DISABLE_SSO is true)
# NEXT_PUBLIC_SSO_MOCK_APP_URL=http://localhost:4200

# Set to "true" to bypass SSO and auto-create fake users
# NEXT_PUBLIC_DISABLE_SSO=true

# Default role for fake users when SSO is disabled:
#   1 = SUPERADMIN
#   2 = TEAM_MEMBER
#   3 = SPONSOR
#   4 = VOLUNTEER
#   5 = HACKER (default)
#   6 = APPLICANT
#   7 = JUDGE
# SSO_DEFAULT_ROLE=5

# Required if SSO_DEFAULT_ROLE=7 (judge)
# JUDGE_DEFAULT_VERTICAL=your-vertical-id
